{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:\\path\\to\\ClaudeTray.exe",
            "args": [
              "--signal",
              "done"
            ],
            "timeout": 15,
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "C:\\path\\to\\ClaudeTray.exe",
            "args": [
              "--signal",
              "attention"
            ],
            "timeout": 15,
            "async": true
          }
        ]
      }
    ]
  }
}
